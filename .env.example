# Copy to .env.local. Never paste passwords, cookies, or tokens into tracked files.
PAPERLYFT_ENV=local
PAPERLYFT_BASE_URL=http://localhost:3000
# Default: .auth/<environment>/accounts.json
# PAPERLYFT_ACCOUNT_MANIFEST=.auth/local/accounts.json
PAPERLYFT_LAB_BASE_URL=http://127.0.0.1:4179
# Set to 1 on the hosted lab for the preparation-only discovery suite.
PAPERLYFT_LAB_DISCOVERY_ONLY=0
# Public imports deliberately reject localhost/private addresses. Host the synthetic
# lab at your own public HTTPS address, then set this for import suites.
# PAPERLYFT_PUBLIC_FIXTURE_BASE_URL=https://fixtures.example.test
PAPERLYFT_ALLOW_MUTATIONS=0
# Keep off until you explicitly authorize paid Gemini/provider processing.
PAPERLYFT_ALLOW_PAID_PROCESSING=0
PAPERLYFT_ALLOW_PROD_CANARY=0
PAPERLYFT_MAX_SOURCE_PAGES=10
PAPERLYFT_MAX_COST_CENTS=500
# Required for production: exact dedicated test subject and run acknowledgment.
# PAPERLYFT_PROD_TEST_SUBJECT=dedicated-canary-subject
# PAPERLYFT_PROD_ACK=production-canary
PAPERLYFT_BROWSER_CHANNEL=chrome
PAPERLYFT_CORPUS_MANIFEST=fixtures/private/corpus.json
PAPERLYFT_CORPUS_SEED=42
PAPERLYFT_CORPUS_COUNT=2
